<?xml version="1.0" encoding="utf-8"?>
<!--
  Languages this app ships, for Android 13+'s per-app language picker (Settings > Apps >
  AnyGest > Language) and for the in-app one. English is the fallback for every
  language not listed; values-pt serves Portuguese from any region.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pt-BR" />
</locale-config>
